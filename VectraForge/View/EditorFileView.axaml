<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:VectraForge.ViewModel"
             xmlns:ae="using:AvaloniaEdit"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="VectraForge.View.EditorFileView"
             x:DataType="vm:EditorFileViewModel">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveCommand}"/>
    </UserControl.KeyBindings>
    <DockPanel>
        <TextBlock DockPanel.Dock="Top" Text="{Binding Message}" IsVisible="{Binding HasMessage}"
                   Foreground="OrangeRed" Margin="8,4" TextWrapping="Wrap"/>
        <ae:TextEditor Document="{Binding Document}" ShowLineNumbers="True"
                       FontFamily="Cascadia Mono,Consolas,Menlo,monospace" />
    </DockPanel>
</UserControl>
