<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VectraForge.ViewModel"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="VectraForge.Windows.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_Help">
                <MenuItem Header="_About VectraForge" Command="{Binding ShowAboutCommand}"/>
            </MenuItem>
        </Menu>
        <DockControl Layout="{Binding Layout}" />
    </DockPanel>
</Window>