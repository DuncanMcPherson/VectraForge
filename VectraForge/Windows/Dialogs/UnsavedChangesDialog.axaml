<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:VectraForge.ViewModel"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="VectraForge.Windows.Dialogs.UnsavedChangesDialog"
        x:DataType="vm:UnsavedChangesDialogViewModel"
        Title="Unsaved Changes" SizeToContent="WidthAndHeight" CanResize="False">
        <StackPanel Margin="16" Spacing="16" MinWidth="320">
                <TextBlock Text="{Binding Prompt}" TextWrapping="Wrap"/>
                <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Content="Save" Command="{Binding SaveCommand}" IsDefault="True"/>
                        <Button Content="Don't Save" Command="{Binding DontSaveCommand}"/>
                        <Button Content="Cancel" Command="{Binding CancelCommand}" IsCancel="True"/>
                </StackPanel>
        </StackPanel>
</Window>
