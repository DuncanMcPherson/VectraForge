<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:VectraForge.ViewModel"
        x:Class="VectraForge.Windows.Dialogs.ProjectPickerDialog"
        x:DataType="vm:ProjectPickerDialogViewModel"
        Width="300" Height="50"
        Title="Select a folder/file">
        <Grid ColumnDefinitions="*,*">
                <Grid.Styles>
                        <Style Selector="Button">
                                <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                        </Style>
                </Grid.Styles>
                <Button Grid.Column="0" Command="{Binding PickFolderCommand}">Open Folder</Button>
                <Button Grid.Column="1" Command="{Binding PickFileCommand}">Open File</Button>
        </Grid>
</Window>
