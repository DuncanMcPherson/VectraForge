<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="using:VectraForge.Converters"
             x:Class="VectraForge.App"
             RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <conv:ParentDirectoryConverter x:Key="ParentDirectoryConverter" />
            <conv:RelativeTimeConverter x:Key="RelativeTimeConverter" />
            <conv:DoubleToGridLengthConverter x:Key="DoubleToGridLengthConverter" />
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SplitterLineBrush">#D4D4D4</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SplitterLineBrush">#111111</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
        <DockFluentTheme/>
        <Style Selector="GridSplitter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="Transparent">
                        <Border x:Name="Line" Background="{DynamicResource SplitterLineBrush}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="GridSplitter.v">
            <Setter Property="Cursor" Value="SizeWestEast"/>
        </Style>
        <Style Selector="GridSplitter.h">
            <Setter Property="Cursor" Value="SizeNorthSouth"/>
        </Style>
        <Style Selector="GridSplitter.v /template/ Border#Line">
            <Setter Property="Width" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style Selector="GridSplitter.h /template/ Border#Line">
            <Setter Property="Height" Value="1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="GridSplitter:pointerover /template/ Border#Line">
            <Setter Property="Background" Value="{DynamicResource SystemAccentColor}" />
        </Style>
    </Application.Styles>
</Application>